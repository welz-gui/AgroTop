# Virtual environments
.venv
venv
env
ENV

# Subprojects with separate lifecycles.
# backend_api is NOT excluded — Dockerfile.api (spec: hospedagem da API
# mobile) builds from this same context and needs backend_api/*.py in the
# COPY . . step. It's a small cost for the web image (Dockerfile) to carry
# those files unused, cheaper than a per-Dockerfile .dockerignore whose
# BuildKit-only override convention isn't guaranteed to be honored by
# `gcloud run deploy --source .`.
mobile
poc

# Tests, tools, docs and database migrations
tests
tools
specs
docs
supabase

# Python cache & artifacts
__pycache__
*.py[cod]
*$py.class
*.so
.pytest_cache
.coverage
htmlcov

# Local databases & logs
*.db
*.sqlite
*.sqlite3
*.log

# Secrets (CRITICAL: never bake credentials into image)
.streamlit/secrets.toml

# Docker-related
Dockerfile
.dockerignore
